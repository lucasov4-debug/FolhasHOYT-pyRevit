<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folhas HOYT" Height="900" Width="1200" MinHeight="760" MinWidth="980" FontSize="13" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Background="#EEF2F6">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#34465A"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E8EFF4"/>
            <Setter Property="Foreground" Value="#30465B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#173A59" CornerRadius="8" Padding="20,14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="FOLHAS HOYT" FontSize="23" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Gerencie vistas, folhas, posições, setores e tamanhos do projeto" FontSize="15" Foreground="#DFECF5" Margin="0,3,0,0"/>
                <TextBlock Text="Como usar: escolha a aba, filtre e marque as linhas. Confira na tabela as edições ou padrões escolhidos e clique em Aplicar. Prévia apenas prepara; ações como Duplicar e Recentralizar executam após confirmação." TextWrapping="Wrap" Foreground="#DFECF5" Margin="0,7,0,0"/>
            </StackPanel>
        </Border>
        <TabControl x:Name="abas" Grid.Row="1">

            <!-- ======================= VISTAS ======================= -->
            <TabItem Header="  Vistas  " FontSize="13">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F4F7FA" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,8">
                        <TextBlock Text="Vistas: confira ou edite Nome e Título da página na tabela (F2). Marque as vistas para duplicar; para renomear em lote, preencha os campos abaixo, clique em Pré-visualizar, confira a tabela e só então Aplicar." TextWrapping="Wrap" Foreground="#34465A"/>
                    </Border>
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <CheckBox x:Name="v_todas" Content="Marcar todas" VerticalAlignment="Center" Margin="0,0,16,0" DockPanel.Dock="Left"/>
                        <TextBlock Text="Filtrar:" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                        <TextBox x:Name="v_filtro" Width="280" Height="26" VerticalContentAlignment="Center" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="v_info" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#5A6472"/>
                    </DockPanel>
                    <DataGrid x:Name="v_grade" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Extended" Background="White" RowHeight="32" ColumnHeaderHeight="34" AlternatingRowBackground="#F4F7FA" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Marcado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Nome da vista (F2 edita)" Binding="{Binding Nome, Mode=TwoWay}" Width="*"/>
                            <DataGridTextColumn Header="Título da página (F2 edita)" Binding="{Binding Titulo, Mode=TwoWay}" Width="*"/>
                            <DataGridTextColumn Header="Em folha" Binding="{Binding Folha}" IsReadOnly="True" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="3" Background="White" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Duplicar as marcadas:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button x:Name="v_dup" Content="Sem detalhamento" Padding="14,4" Margin="0,0,8,0"/>
                                <Button x:Name="v_dup_det" Content="Com detalhamento" Padding="14,4"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Nome em lote:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Prefixo" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="v_pre" Width="90" Height="24" Margin="0,0,10,0"/>
                                <TextBlock Text="Sufixo" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="v_suf" Width="90" Height="24" Margin="0,0,10,0"/>
                                <TextBlock Text="Localizar" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="v_bus" Width="110" Height="24" Margin="0,0,10,0"/>
                                <TextBlock Text="Trocar por" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="v_tro" Width="110" Height="24" Margin="0,0,14,0"/>
                                <Button x:Name="v_previa" Content="Pré-visualizar" Padding="14,4" Margin="0,0,8,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="v_aplicar" Content="Aplicar nomes e títulos editados" Padding="16,4" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <Button x:Name="v_desfazer" Content="Descartar edições" Padding="14,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="v_status" Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#5A6472"/>
                </Grid>
            </TabItem>

            <!-- ======================= FOLHAS ======================= -->
            <TabItem Header="  Folhas  " FontSize="13">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F4F7FA" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,8">
                        <TextBlock Text="Folhas: marque as linhas para usar os comandos. Em edição em lote, abra o botão abaixo, escolha número, nome ou Nº da prancha, faça a prévia e aplique. Expanda Outras ações para duplicar, mover legendas, trocar tipo e mais." TextWrapping="Wrap" Foreground="#34465A"/>
                    </Border>
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <CheckBox x:Name="f_todas" Content="Marcar todas" VerticalAlignment="Center" Margin="0,0,16,0" DockPanel.Dock="Left"/>
                        <TextBlock Text="Filtrar:" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                        <TextBox x:Name="f_filtro" Width="280" Height="26" VerticalContentAlignment="Center" Margin="0,0,16,0" DockPanel.Dock="Left"/>
                        <CheckBox x:Name="f_so_novas" Content="Só folhas novas" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="f_info" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#5A6472"/>
                    </DockPanel>
                    <DataGrid x:Name="f_grade" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Extended" Background="White" RowHeight="32" ColumnHeaderHeight="34" AlternatingRowBackground="#F4F7FA" AlternationCount="2">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Nova}" Value="True">
                                        <Setter Property="Background" Value="#CFEFD6"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Marcado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="" Binding="{Binding Marca}" IsReadOnly="True" Width="42"/>
                            <DataGridTextColumn Header="Número (F2)" Binding="{Binding Numero, Mode=TwoWay}" Width="115"/>
                            <DataGridTextColumn Header="Nome da folha (F2)" Binding="{Binding NomeFolha, Mode=TwoWay}" Width="2*" MinWidth="260"/>
                            <DataGridTextColumn Header="Tipo de folha" Binding="{Binding TipoFolha}" IsReadOnly="True" Width="130"/>
                            <DataGridTextColumn Header="Nº da prancha (F2)" Binding="{Binding Prancha, Mode=TwoWay}" Width="135"/>
                            <DataGridTextColumn Header="Legendas" Binding="{Binding Legenda}" IsReadOnly="True" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Vistas" Binding="{Binding Vistas}" IsReadOnly="True" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="3" Background="#F4F7FA" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <Button x:Name="f_abrir_ajustes" Content="Editar números, nomes e Nº da prancha em lote..." HorizontalAlignment="Left" Padding="16,6" Background="#176B85" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Expander Header="Outras ações nas folhas marcadas — duplicar, ajustar, trocar ou apagar" IsExpanded="False" Foreground="#173A59" FontWeight="SemiBold">
                            <ScrollViewer MaxHeight="175" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <StackPanel>
                            <WrapPanel Width="980">
                                <TextBlock Text="Duplicar as marcadas (sem vistas):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="sufixo do número" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_copia" Text="-COPIA" Width="90" Height="24" Margin="0,0,10,0"/>
                                <Button x:Name="f_dup" Content="Duplicar folhas" Padding="14,4" Margin="0,0,16,0"/>
                                <Button x:Name="f_limpar_novas" Content="Limpar destaque das novas" Padding="14,4" Margin="0,0,16,0"/>
                                <Button x:Name="f_titulos" Content="Padronizar título das vistas (+2 cm)" Padding="14,4" Margin="0,0,16,0"
                                        ToolTip="Sobe o título de cada vista 2 cm acima da linha da folha, nas folhas marcadas (ou em todas, se nenhuma estiver marcada)."/>
                                <Button x:Name="f_apagar" Content="Apagar folhas marcadas/selecionadas" Padding="14,4" Foreground="#A61B1B"/>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Mover legendas das marcadas:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="f_mov_dir" Width="90" Height="24" SelectedIndex="0" Margin="0,0,8,0">
                                    <ComboBoxItem Content="Direita"/>
                                    <ComboBoxItem Content="Esquerda"/>
                                    <ComboBoxItem Content="Cima"/>
                                    <ComboBoxItem Content="Baixo"/>
                                </ComboBox>
                                <TextBox x:Name="f_mov_val" Text="1" Width="60" Height="24" VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="cm" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="f_mover" Content="Mover legendas" Padding="14,4"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Ajustar tamanho das marcadas pela folha padrão:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="f_padrao" Width="300" Height="24" Margin="0,0,10,0"/>
                                <Button x:Name="f_ajustar_tam" Content="Ajustar tamanho" Padding="14,4"
                                        ToolTip="Copia só Altura e Largura do carimbo da folha padrão. Não troca o tipo nem mexe nas vistas."/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Trocar legenda nas marcadas:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="sai" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="f_leg_sai" Width="250" Height="24" Margin="0,0,10,0"/>
                                <TextBlock Text="entra" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="f_leg_entra" Width="250" Height="24" Margin="0,0,10,0"/>
                                <Button x:Name="f_leg_trocar" Content="Trocar" Padding="14,4"/>
                            </StackPanel>
                            <TextBlock Text="&quot;Sai&quot; lista as legendas das folhas marcadas ou selecionadas (entre parênteses, em quantas aparece). A nova entra no mesmo lugar."
                                       Foreground="#5A6472" Margin="0,3,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Trocar o tipo de folha nas marcadas:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="f_tipo_novo" Width="300" Height="24" Margin="0,0,10,0"/>
                                <Button x:Name="f_tipo_trocar" Content="Trocar tipo" Padding="14,4"/>
                            </StackPanel>
                                </StackPanel>
                            </ScrollViewer></Expander>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="f_status" Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#5A6472"/>
                </Grid>
            </TabItem>

            <!-- ======================= CASAR ======================= -->
            <TabItem Header="  Casar vistas e folhas  " FontSize="13">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F4F7FA" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,8">
                        <TextBlock Text="Casar vistas e folhas: filtre as folhas e clique no campo Vista da linha para escolher uma vista. Use as opções para mostrar folhas sem vista e ocultar vistas já colocadas. Quando terminar os pares, clique em Posicionar centralizado no Revit." TextWrapping="Wrap" Foreground="#34465A"/>
                    </Border>
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="FOLHAS" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                        <TextBox x:Name="c_filtro_f" Width="180" Height="24" DockPanel.Dock="Left" Margin="0,0,14,0"/>
                        <CheckBox x:Name="c_sem_vista" Content="só folhas sem vista" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" DockPanel.Dock="Left"/>
                        <CheckBox x:Name="c_ocultar" Content="lista: ocultar vistas já em folha" IsChecked="True" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="c_pares" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#5A6472"/>
                    </DockPanel>
                    <DataGrid x:Name="c_grade_f" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Single" Background="White" RowHeight="34" ColumnHeaderHeight="34" AlternatingRowBackground="#F4F7FA" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="110"/>
                            <DataGridTextColumn Header="Nome da folha" Binding="{Binding NomeFolha}" Width="*"/>
                            <DataGridTextColumn Header="Vistas" Binding="{Binding Vistas}" Width="50"/>
                            <DataGridTemplateColumn Header="Vista (clique para escolher)" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding VistaTxt}" HorizontalContentAlignment="Left"
                                                Padding="8,2" Margin="1" Background="#F4F7FB"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Popup x:Name="c_popup" StaysOpen="False" Placement="Bottom">
                        <Border Background="White" BorderBrush="#4A78B5" BorderThickness="1" Padding="6" Width="460">
                            <StackPanel>
                                <TextBox x:Name="c_busca" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,6"
                                         ToolTip="Digite parte do nome. Enter escolhe o primeiro da lista."/>
                                <ListBox x:Name="c_lista" Height="280" DisplayMemberPath="Texto"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <DockPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button x:Name="c_posicionar" Content="Posicionar centralizado no Revit" Padding="18,4"
                                FontWeight="SemiBold" DockPanel.Dock="Right"/>
                        <Button x:Name="c_limpar" Content="Limpar escolhas" Padding="12,4" Margin="0,0,14,0" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="c_status" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#5A6472"/>
                    </DockPanel>
                </Grid>
            </TabItem>
            <!-- ======================= SETORES ======================= -->
            <TabItem Header="  Setores  " FontSize="13">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#F4F7FA" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,8">
                        <TextBlock Text="Setores: à esquerda, marque as vistas de referência — a ordem é da esquerda para a direita. À direita, marque as plantas de destino e informe quantos setores cada uma recebe (vazio = todos). Confira os códigos e clique em Replicar setores." TextWrapping="Wrap" Foreground="#34465A"/>
                    </Border>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock Text="1. REFERÊNCIAS" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                            <TextBox x:Name="s_filtro_r" Width="150" Height="24" DockPanel.Dock="Left" Margin="0,0,12,0"/>
                            <TextBlock Text="primeiro setor: S" VerticalAlignment="Center" Margin="0,0,2,0" DockPanel.Dock="Left"/>
                            <TextBox x:Name="s_inicio" Text="5" Width="34" Height="24" DockPanel.Dock="Left"/>
                        </DockPanel>
                        <TextBlock x:Name="s_resumo" TextWrapping="Wrap" Foreground="#5A6472" Margin="0,4,0,0"/>
                    </StackPanel>
                    <DockPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="2. PLANTAS DE DESTINO" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                        <CheckBox x:Name="s_todas_d" Content="Marcar todas" VerticalAlignment="Center" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                        <TextBox x:Name="s_filtro_d" Width="150" Height="24" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="s_info" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#5A6472"/>
                    </DockPanel>
                    <DataGrid x:Name="s_grade_r" Grid.Row="2" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Extended" Background="White" RowHeight="32" ColumnHeaderHeight="34" AlternatingRowBackground="#F4F7FA" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Marcado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Setor" Binding="{Binding Setor}" Width="50"/>
                            <DataGridTextColumn Header="Vista" Binding="{Binding Nome}" Width="*"/>
                            <DataGridTextColumn Header="Recorte" Binding="{Binding Recorte}" Width="56"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid x:Name="s_grade_d" Grid.Row="2" Grid.Column="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Extended" Background="White" RowHeight="32" ColumnHeaderHeight="34" AlternatingRowBackground="#F4F7FA" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Marcado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Planta" Binding="{Binding Nome}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Nº de setores (F2; vazio = todos)" Binding="{Binding Qtd, Mode=TwoWay}" Width="210"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <Button x:Name="s_replicar" Content="Replicar setores nas marcadas" Padding="18,4" FontWeight="SemiBold" DockPanel.Dock="Right"/>
                        <CheckBox x:Name="s_anot" Content="ocultar o que está fora do recorte" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" DockPanel.Dock="Left"/>
                        <TextBlock Text="Nº de setores nas marcadas:" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                        <TextBox x:Name="s_qtd" Width="40" Height="24" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                        <Button x:Name="s_aplicar_qtd" Content="Aplicar" Padding="12,3" Margin="0,0,14,0" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="s_status" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#5A6472"/>
                    </DockPanel>
                </Grid>
            </TabItem>
            <!-- ======================= LEVAR ======================= -->
            <TabItem Header="  Levar folhas para outro documento  " FontSize="13">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <Border Background="#F4F7FA" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,8">
                            <TextBlock Text="Levar folhas: abra ou ative o documento de destino no Revit e selecione-o na lista. Marque as folhas que deseja copiar e clique em Levar folhas marcadas; confirme para criar as cópias no documento escolhido." TextWrapping="Wrap" Foreground="#34465A"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Documento de destino (aberto):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="l_destino" Width="420" Height="26"/>
                            <Button x:Name="l_atualizar" Content="Atualizar lista" Padding="10,3" Margin="10,0,0,0"/>
                        </StackPanel>
                        <DockPanel>
                            <CheckBox x:Name="l_todas" Content="Marcar todas" VerticalAlignment="Center" Margin="0,0,16,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Filtrar:" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                            <TextBox x:Name="l_filtro" Width="260" Height="26" VerticalContentAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="l_info" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#5A6472"/>
                        </DockPanel>
                    </StackPanel>
                    <DataGrid x:Name="l_grade" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Extended" Background="White" RowHeight="32" ColumnHeaderHeight="34" AlternatingRowBackground="#F4F7FA" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Marcado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="110"/>
                            <DataGridTextColumn Header="Nome" Binding="{Binding NomeFolha}" Width="*"/>
                            <DataGridTextColumn Header="Legendas" Binding="{Binding Legenda}" Width="260"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button x:Name="l_levar" Content="Levar folhas marcadas" Padding="18,4" FontWeight="SemiBold" DockPanel.Dock="Right"/>
                        <TextBlock x:Name="l_status" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#5A6472"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ======================= TAMANHOS ======================= -->
            <TabItem Header="  Tamanhos  " FontSize="13">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F4F7FA" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,8">
                        <TextBlock Text="Tamanhos: digite Altura e Largura em cm por folha ou escolha um padrão na última coluna. Valores digitados prevalecem sobre o padrão. Aplicar grava no carimbo; cadastrar padrão apenas salva a opção na lista." TextWrapping="Wrap" Foreground="#34465A"/>
                    </Border>
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <CheckBox x:Name="t_todas" Content="Marcar todas" VerticalAlignment="Center" Margin="0,0,16,0" DockPanel.Dock="Left"/>
                        <TextBlock Text="Pesquisar:" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                        <TextBox x:Name="t_filtro" Width="280" Height="26" VerticalContentAlignment="Center" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="t_info" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#5A6472"/>
                    </DockPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="t_abrir_padrao" Content="+ Cadastrar padrão de tamanho" Padding="14,4"/>
                        <TextBlock Text="Os padrões salvos aparecem na última coluna." VerticalAlignment="Center" Foreground="#5A6472" Margin="12,0,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="t_grade" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Extended" Background="White" RowHeight="32" ColumnHeaderHeight="34" AlternatingRowBackground="#F4F7FA" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Marcado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Número" Binding="{Binding Numero}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Nome" Binding="{Binding NomeFolha}" IsReadOnly="True" Width="180"/>
                            <DataGridTextColumn Header="Tipo de folha" Binding="{Binding TipoFolha}" IsReadOnly="True" Width="130"/>
                            <DataGridTextColumn Header="Atual H (cm)" Binding="{Binding Altura}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Atual L (cm)" Binding="{Binding Largura}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Altura" Binding="{Binding AlturaManual, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="125"/>
                            <DataGridTextColumn Header="Largura" Binding="{Binding LarguraManual, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                            <DataGridTemplateColumn Header="Padrão pronto" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Opcoes}" DisplayMemberPath="Texto" SelectedValuePath="Chave"
                                                  SelectedValue="{Binding Padrao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  MinHeight="26" VerticalContentAlignment="Center" ToolTip="Escolha o tamanho; só Aplicar grava no carimbo."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="t_aplicar" Content="Aplicar tamanhos pendentes" Padding="16,4" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <Button x:Name="t_desfazer" Content="Descartar edições" Padding="14,4"/>
                    </StackPanel>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="t_recentralizar" Content="Recentralizar vistas das marcadas" Padding="16,4" Background="#2E9E55" Foreground="White" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock x:Name="t_status" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#5A6472"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <!-- ======================= LEGENDA ======================= -->
            <TabItem Header="  Legenda  ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F4F7FA" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,10">
                        <TextBlock Text="Escolha uma legenda e marque as folhas. A ação usa Viewport: No Title e a posição calibrada para as folhas HOYT (2,53 cm à direita e 0,41 cm acima do alinhamento anterior). Se a legenda já estiver na folha, corrige sua posição e seu tipo sem duplicar." TextWrapping="Wrap" Foreground="#34465A"/>
                    </Border>
                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Legenda:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="lg_legenda" MinWidth="380" MaxWidth="650" Height="28" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Grid.Row="2" Margin="0,0,0,8">
                        <CheckBox x:Name="lg_todas" Content="Marcar todas visíveis" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <TextBlock Text="Pesquisar folha:" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBox x:Name="lg_filtro" Width="280" Height="26" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="lg_info" VerticalAlignment="Center" Foreground="#5A6472" Margin="16,0,0,0"/>
                    </DockPanel>
                    <DataGrid x:Name="lg_grade" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended" Background="White"
                              RowHeight="32" ColumnHeaderHeight="34" AlternatingRowBackground="#F4F7FA" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><CheckBox IsChecked="{Binding Marcado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Número" Binding="{Binding Numero}" IsReadOnly="True" Width="115"/>
                            <DataGridTextColumn Header="Nome da folha" Binding="{Binding NomeFolha}" IsReadOnly="True" Width="450"/>
                            <DataGridTextColumn Header="Legendas atuais" Binding="{Binding Legendas}" IsReadOnly="True" Width="320"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="4" Margin="0,10,0,0">
                        <Button x:Name="lg_aplicar" Content="Inserir ou corrigir legenda" Padding="16,5" FontWeight="SemiBold" Background="#173A59" Foreground="White" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="lg_status" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#5A6472" Margin="14,0,0,0"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="btn_fechar" Content="Fechar" Padding="18,4" DockPanel.Dock="Right"/>
            <Button x:Name="btn_atualizar" Content="↻ Atualizar esta aba" Padding="12,4" Margin="0,0,10,0" DockPanel.Dock="Right"
                    ToolTip="Relê do Revit os dados da aba atual (use depois de mudar algo no projeto)."/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,16,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=abas}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button x:Name="f_criar" Content="＋ Duplicar folhas marcadas" Padding="14,4" Background="#176B85" Foreground="White" FontWeight="SemiBold"
                        ToolTip="Cria uma cópia de cada folha marcada (ou selecionada), com legendas e tabelas."/>
            </StackPanel>
            <TextBlock Text="Cada operação é uma única ação no Revit: Ctrl+Z desfaz o lote inteiro." VerticalAlignment="Center" Foreground="#949CA8"/>
        </DockPanel>
    </Grid>
</Window>
