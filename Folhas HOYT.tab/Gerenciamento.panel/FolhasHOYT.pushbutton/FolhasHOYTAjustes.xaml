<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folhas HOYT — edição em lote" Width="1100" Height="400"
        MinWidth="900" MinHeight="360" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" Background="#EEF2F6" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#173A59" CornerRadius="7" Padding="16,12" Margin="0,0,0,10">
            <StackPanel><TextBlock Text="EDIÇÃO EM LOTE" Foreground="White" FontSize="19" FontWeight="Bold"/>
            <TextBlock Text="Marque as folhas na janela principal. Configure número, nome ou Nº da prancha; use Prévia para conferir na tabela e Aplicar para gravar no Revit."
                       Foreground="#DFECF5" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Border Background="White" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="8" Padding="14">
<StackPanel>
                            <TextBlock Text="Em lote nas marcadas - prévia na tabela, depois Aplicar" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Número:" Width="64" VerticalAlignment="Center"/>
                                <TextBlock Text="Prefixo" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_n_pre" Width="70" Height="24" Margin="0,0,8,0"/>
                                <TextBlock Text="Sufixo" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_n_suf" Width="70" Height="24" Margin="0,0,8,0"/>
                                <TextBlock Text="Localizar" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_n_bus" Width="80" Height="24" Margin="0,0,8,0"/>
                                <TextBlock Text="Trocar por" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_n_tro" Width="80" Height="24" Margin="0,0,14,0"/>
                                <CheckBox x:Name="f_seq" Content="Sequência:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="início" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_ini" Text="1" Width="44" Height="24" Margin="0,0,6,0"/>
                                <TextBlock Text="passo" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_passo" Text="1" Width="36" Height="24" Margin="0,0,6,0"/>
                                <TextBlock Text="dígitos" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_dig" Text="2" Width="36" Height="24" Margin="0,0,10,0"/>
                                <Button x:Name="f_prev_n" Content="Prévia" Padding="12,3"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Nome:" Width="64" VerticalAlignment="Center"/>
                                <TextBlock Text="Prefixo" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_m_pre" Width="70" Height="24" Margin="0,0,8,0"/>
                                <TextBlock Text="Sufixo" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_m_suf" Width="70" Height="24" Margin="0,0,8,0"/>
                                <TextBlock Text="Localizar" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_m_bus" Width="110" Height="24" Margin="0,0,8,0"/>
                                <TextBlock Text="Trocar por" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_m_tro" Width="110" Height="24" Margin="0,0,14,0"/>
                                <Button x:Name="f_prev_m" Content="Prévia" Padding="12,3"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Nº Prancha:" Width="88" VerticalAlignment="Center"/>
                                <TextBlock Text="Prefixo" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_p_pre" Width="70" Height="24" Margin="0,0,8,0"/>
                                <TextBlock Text="Sufixo" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_p_suf" Width="70" Height="24" Margin="0,0,8,0"/>
                                <TextBlock Text="Localizar" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_p_bus" Width="80" Height="24" Margin="0,0,8,0"/>
                                <TextBlock Text="Trocar por" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="f_p_tro" Width="80" Height="24" Margin="0,0,14,0"/>
                                <CheckBox x:Name="f_p_seq" Content="Sequência (usa início/passo/dígitos acima)" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="f_prev_p" Content="Prévia" Padding="12,3"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="f_aplicar" Content="Aplicar números, nomes e nº da prancha" Padding="16,4" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <Button x:Name="f_desfazer" Content="Descartar edições" Padding="14,4"/>
                            </StackPanel>
                        </StackPanel>
            </Border>
        </ScrollViewer>
        <Button x:Name="aj_fechar" Grid.Row="2" Content="Voltar às folhas" HorizontalAlignment="Right" Padding="18,7" Margin="0,10,0,0"/>
    </Grid>
</Window>
