<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastrar padrão de tamanho" Width="490" Height="350"
        MinWidth="440" MinHeight="330" MaxWidth="700" MaxHeight="470"
        FontFamily="Segoe UI" FontSize="13" Background="#EEF2F6"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#173A59" CornerRadius="7" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="NOVO PADRÃO DE FOLHA" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Salve um tamanho para reutilizar na lista da aba Tamanhos." Foreground="#DFECF5" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="7" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome do padrão" VerticalAlignment="Center" Margin="0,0,8,10"/>
                <TextBox x:Name="p_nome" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Altura (cm)" VerticalAlignment="Center" Margin="0,0,8,10"/>
                <TextBox x:Name="p_altura" Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Largura (cm)" VerticalAlignment="Center" Margin="0,0,8,10"/>
                <TextBox x:Name="p_largura" Grid.Row="2" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="p_status" Grid.Row="3" Grid.ColumnSpan="2" Foreground="#B42318" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="p_cancelar" Content="Cancelar" Padding="16,5" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="p_salvar" Content="Salvar padrão" Padding="18,5" Background="#173A59" Foreground="White" FontWeight="SemiBold" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
